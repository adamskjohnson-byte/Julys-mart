{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Product name as it appears on the shelf and on the site"
    },
    "department": {
      "type": "string",
      "enum": [
        "provisions",
        "drinks",
        "snacks",
        "skincare"
      ],
      "enumColors": [
        "green",
        "yellow",
        "purple",
        "pink"
      ],
      "description": "Which department of the supermarket the product belongs to"
    },
    "price": {
      "type": "number",
      "description": "Price in Nigerian naira"
    },
    "unit": {
      "type": "string",
      "description": "Pack size or volume, e.g. 5kg, 3 litres, pack of 6"
    },
    "image": {
      "type": "string",
      "description": "Product image: either a full image URL or a photo key used by the site"
    },
    "blurb": {
      "type": "string",
      "description": "Short selling description shown in the quick view"
    },
    "badge": {
      "type": "string",
      "description": "Optional shelf label such as New in or Best seller"
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "description": "Show this product in The July Edit on the home page"
    },
    "in_stock": {
      "type": "boolean",
      "default": true,
      "description": "Whether the item is currently on the shelf"
    },
    "sample_data": {
      "type": "boolean",
      "default": false,
      "description": "Marks placeholder catalogue data with sample prices, to be replaced with real shelf prices"
    }
  },
  "required": [
    "name",
    "department",
    "price"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}